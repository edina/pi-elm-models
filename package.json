{
  "name": "pi-elm-models",
  "version": "0.2.0",
  "description": "Pi coding agent provider package for University of Edinburgh ELM-hosted models.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pi-elm-models": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edina/pi-elm-models.git"
  },
  "bugs": {
    "url": "https://github.com/edina/pi-elm-models/issues"
  },
  "homepage": "https://github.com/edina/pi-elm-models#readme",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "elm",
    "qwen",
    "university-of-edinburgh"
  ],
  "author": "EDINA, University of Edinburgh",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
